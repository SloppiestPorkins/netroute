<Window x:Class="NetRoute.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NetRoute.App"
        Title="NetRoute" Width="980" Height="740" MinWidth="780" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>

        <!-- A destination: Gaming / Downloads / Default, used by Add App and Change Network. -->
        <DataTemplate x:Key="DestinationTemplate">
            <Button Style="{StaticResource ChoiceButton}"
                    Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="16"
                               Foreground="{Binding RoleBrush}"
                               Visibility="{Binding IsCurrent, Converter={StaticResource BoolVisibility}}" />
                    <Border Width="42" Height="42" CornerRadius="10" Background="{Binding RoleTint}">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="19"
                                   Foreground="{Binding RoleBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Button>
        </DataTemplate>

        <!-- An adapter in a picker. -->
        <DataTemplate x:Key="AdapterTemplate">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding StateBrush}" />
                    <TextBlock Text="{Binding StateText}" Style="{StaticResource Caption}" Margin="7,0,0,0" />
                </StackPanel>
                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18" Margin="2,0,14,0"
                           Foreground="{StaticResource MutedBrush}" />
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Line}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- Why? -->
        <DataTemplate DataType="{x:Type local:WhyViewModel}">
            <StackPanel Width="540">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                <ItemsControl ItemsSource="{Binding Reasons}" Margin="0,18,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding Brush}"
                                           VerticalAlignment="Top" Margin="0,3,12,0" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <Border Style="{StaticResource Pill}" Background="{Binding FooterTint}" HorizontalAlignment="Left" Margin="0,16,0,0">
                    <TextBlock Text="{Binding Footer}" Foreground="{Binding FooterBrush}" FontWeight="SemiBold" />
                </Border>
                <Expander Header="Advanced details" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"
                          Visibility="{Binding Technical, Converter={StaticResource NullVisibility}}">
                    <TextBox Text="{Binding Technical, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas"
                             FontSize="12" Margin="0,8,0,0" MaxHeight="160" VerticalScrollBarVisibility="Auto" />
                </Expander>
                <Button Content="Close" HorizontalAlignment="Right" Margin="0,22,0,0" IsCancel="True"
                        Command="{Binding DataContext.CloseOverlayCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Change Network -->
        <DataTemplate DataType="{x:Type local:ChangeNetworkViewModel}">
            <StackPanel Width="500">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" Margin="0,0,0,18" />
                <ItemsControl ItemsSource="{Binding Destinations}" ItemTemplate="{StaticResource DestinationTemplate}" />
                <Button Content="Cancel" HorizontalAlignment="Right" Margin="0,8,0,0" IsCancel="True"
                        Command="{Binding DataContext.CloseOverlayCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Role adapter picker -->
        <DataTemplate DataType="{x:Type local:AdapterPickerViewModel}">
            <StackPanel Width="540">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,16"
                           Text="Apps assigned to this role follow it to the new connection. No app changes role." />
                <ListBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding Selected}" ItemTemplate="{StaticResource AdapterTemplate}" MaxHeight="320" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Cancel" Margin="0,0,8,0" IsCancel="True"
                            Command="{Binding DataContext.CloseOverlayCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Content="Use this connection" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Live use -->
        <DataTemplate DataType="{x:Type local:LiveViewModel}">
            <Grid Width="640" MaxHeight="580">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="What's using each network" Style="{StaticResource H2}" />
                <TextBlock Grid.Row="1" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,16"
                           Text="Live connections and speeds, refreshed every 2 seconds. Traffic that stays inside your PC isn't shown." />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Empty}" Style="{StaticResource Caption}" Visibility="{Binding Empty, Converter={StaticResource NullVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,18">
                                        <DockPanel Margin="0,0,0,8">
                                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource SurfaceAltBrush}">
                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding Accent}" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,4">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Rate}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding More}" Style="{StaticResource Caption}" Margin="4,4,0,0"
                                                   Visibility="{Binding More, Converter={StaticResource NullVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="3" Text="{Binding Footnote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="{Binding Footnote, Converter={StaticResource NullVisibility}}" />
                <Button Grid.Row="4" Content="Close" HorizontalAlignment="Right" Margin="0,14,0,0" IsCancel="True"
                        Command="{Binding DataContext.CloseOverlayCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </Grid>
        </DataTemplate>

        <!-- Confirmation -->
        <DataTemplate DataType="{x:Type local:ConfirmViewModel}">
            <StackPanel Width="480">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" LineHeight="21" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="Cancel" Margin="0,0,8,0" IsCancel="True"
                            Command="{Binding DataContext.CloseOverlayCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Content="{Binding ConfirmText}" Style="{StaticResource DangerButton}" Command="{Binding ConfirmCommand}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Pause: for how long -->
        <DataTemplate DataType="{x:Type local:PauseViewModel}">
            <StackPanel Width="460">
                <TextBlock Text="Pause protection" Style="{StaticResource H2}" />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,16"
                           Text="While paused, every app uses normal Windows routing. Your app list is kept." />
                <ItemsControl ItemsSource="{Binding Choices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ChoiceButton}"
                                    Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Cancel" HorizontalAlignment="Right" Margin="0,8,0,0" IsCancel="True"
                        Command="{Binding DataContext.CloseOverlayCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Check-up -->
        <DataTemplate DataType="{x:Type local:HealthViewModel}">
            <Grid Width="660" MaxHeight="600">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Check-up" Style="{StaticResource H2}" />
                <TextBlock Grid.Row="1" Text="{Binding Summary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,16" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{Binding FixText}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="14,0,0,0"
                                                Visibility="{Binding FixText, Converter={StaticResource NullVisibility}}"
                                                Command="{Binding DataContext.FixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding Brush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                       Visibility="{Binding Detail, Converter={StaticResource NullVisibility}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Check again" Margin="0,0,8,0" Command="{Binding RecheckCommand}" />
                    <Button Content="Close" IsCancel="True"
                            Command="{Binding DataContext.CloseOverlayCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- After setup: put download apps on Downloads -->
        <DataTemplate DataType="{x:Type local:SuggestDownloadsViewModel}">
            <StackPanel Width="520">
                <TextBlock Text="Keep downloads off your Gaming connection?" Style="{StaticResource H2}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,16"
                           Text="These download apps are on your PC. Put them on Downloads so game updates never compete with your games. You can change this later." />
                <TextBlock Text="Looking for download apps…" Style="{StaticResource Caption}"
                           Visibility="{Binding Loading, Converter={StaticResource BoolVisibility}}" />
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ChoiceButton}" Command="{Binding ToggleCommand}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding CheckGlyph}" FontSize="18"
                                               Foreground="{StaticResource DownloadsBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="Windows Update, Microsoft Store and Xbox app downloads are kept on Downloads too. You can turn that off in Check-up." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="Skip" Margin="0,0,8,0" IsCancel="True"
                            Command="{Binding DataContext.CloseOverlayCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Content="Put on Downloads" Style="{StaticResource PrimaryButton}" Command="{Binding AddSelectedCommand}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Add App -->
        <DataTemplate DataType="{x:Type local:AddAppViewModel}">
            <Grid Width="620" Height="520">
                <!-- Step 1: pick an app -->
                <Grid Visibility="{Binding Step, Converter={StaticResource PageVisibility}, ConverterParameter=1}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="What do you want to route?" Style="{StaticResource H2}" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"
                             ItemContainerStyle="{StaticResource PillItem}" Margin="0,16,0,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <TextBox Grid.Row="2" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Tag="Search apps" Margin="0,14,0,12" />
                    <Grid Grid.Row="3">
                        <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding Running, Converter={StaticResource BoolVisibility}}">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource GoodBrush}" />
                                            <TextBlock Text="Running" Style="{StaticResource Caption}" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Secondary}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Looking for your apps and games…" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Loading, Converter={StaticResource BoolVisibility}}" />
                        <TextBlock Text="{Binding Empty}" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                    <DockPanel Grid.Row="4" Margin="0,14,0,0">
                        <Button Content="Browse for a program…" Style="{StaticResource LinkButton}" Command="{Binding BrowseCommand}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Margin="0,0,8,0" IsCancel="True"
                                    Command="{Binding DataContext.CloseOverlayCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Next" Style="{StaticResource PrimaryButton}" Command="{Binding NextCommand}" MinWidth="90" />
                        </StackPanel>
                    </DockPanel>
                </Grid>

                <!-- Step 2: where should it connect -->
                <StackPanel Visibility="{Binding Step, Converter={StaticResource PageVisibility}, ConverterParameter=2}">
                    <TextBlock Style="{StaticResource H2}">
                        <Run Text="Where should" /> <Run Text="{Binding SelectedName, Mode=OneWay}" /> <Run Text="connect?" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Destinations}" ItemTemplate="{StaticResource DestinationTemplate}" Margin="0,18,0,0" />
                    <DockPanel Margin="0,8,0,0">
                        <Button Content="Back" Style="{StaticResource GhostButton}" Command="{Binding BackCommand}" />
                        <Button Content="Cancel" HorizontalAlignment="Right" IsCancel="True"
                                Command="{Binding DataContext.CloseOverlayCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" Background="{StaticResource WindowBrush}">

        <!-- Loading -->
        <TextBlock Text="Connecting to NetRoute…" Style="{StaticResource Caption}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Loading}" />

        <!-- Service not running -->
        <StackPanel MaxWidth="540" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=ServiceDown}">
            <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource WarnTintBrush}" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="28" Foreground="{StaticResource WarnBrush}" HorizontalAlignment="Center" />
            </Border>
            <TextBlock Text="NetRoute's background service isn't running" Style="{StaticResource H2}" TextAlignment="Center" Margin="0,20,0,0" />
            <TextBlock Style="{StaticResource Caption}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="21"
                       Text="Until it's running, nothing is keeping your apps on the network you chose. Start it here (Windows will ask for permission), or run INSTALL-NETROUTE.cmd if it isn't installed." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                <Button Style="{StaticResource PrimaryButton}" MinWidth="150" Margin="0,0,8,0" Command="{Binding StartServiceCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Margin="0,0,8,0" />
                        <TextBlock Text="Start NetRoute" />
                    </StackPanel>
                </Button>
                <Button Content="Try again" MinWidth="110" Command="{Binding RetryCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- First run -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Setup}">
            <StackPanel MaxWidth="720" Margin="32,40,32,32" DataContext="{Binding Setup}">
                <TextBlock Text="Let's set up your connections." Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Caption}" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,26"
                           Text="Choose which connection your games use and which one handles downloads. You can change this any time." />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" Foreground="{StaticResource GamingBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="GAMING NETWORK" Style="{StaticResource Section}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding Gaming}" ItemTemplate="{StaticResource AdapterTemplate}" />

                <StackPanel Orientation="Horizontal" Margin="0,22,0,10">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{StaticResource DownloadsBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="DOWNLOAD NETWORK" Style="{StaticResource Section}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding Downloads}" ItemTemplate="{StaticResource AdapterTemplate}" />

                <TextBlock Text="{Binding SameWarning}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Visibility="{Binding SameWarning, Converter={StaticResource NullVisibility}}" />
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14,12" Margin="0,20,0,0">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top" Margin="0,2,10,0" />
                        <TextBlock Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" LineHeight="19"
                                   Text="Your Download network becomes Windows' default connection, so Steam, browsers and updates use it without being told. Games you put on Gaming are moved onto the Gaming network, together with anything they start." />
                    </DockPanel>
                </Border>
                <Button Content="Finish" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,22,0,0" MinWidth="130"
                        Command="{Binding FinishCommand}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Main -->
        <Grid Margin="32,24,32,16" Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Main}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding OpenCheckupCommand}" Margin="0,0,8,0" ToolTip="Check everything that affects where your traffic goes">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding CheckupText}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenLiveCommand}" Margin="0,0,8,0" ToolTip="See which apps are using each network right now">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" Margin="0,0,8,0" />
                            <TextBlock Text="Live use" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding TogglePauseAllCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE769;" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding PauseText}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerButton}" Command="{Binding EmergencyDisableCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" Margin="0,0,8,0" />
                            <TextBlock Text="Emergency Disable" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="NetRoute" Style="{StaticResource H1}" />
                    <Border Style="{StaticResource Pill}" Background="{Binding OverallTint}" Margin="14,5,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding OverallBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding OverallText}" FontWeight="SemiBold" FontSize="13" Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- Banners -->
            <StackPanel Grid.Row="1">
                <!-- A game is online that isn't in the list -->
                <Border Background="{StaticResource GamingTintBrush}" CornerRadius="10" Padding="14,10" Margin="0,16,0,0"
                        Visibility="{Binding NewGame, Converter={StaticResource NullVisibility}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Button Content="Don't ask again" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Command="{Binding NeverNewGameCommand}" />
                            <Button Content="Not now" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Command="{Binding DismissNewGameCommand}" />
                            <Button Content="Put on Gaming" Style="{StaticResource PrimaryButton}" Command="{Binding AcceptNewGameCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" Foreground="{StaticResource GamingBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding NewGame.Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <Border Background="{StaticResource WarnTintBrush}" BorderBrush="#55F5A524" BorderThickness="1"
                        CornerRadius="10" Padding="14,10" Margin="0,16,0,0"
                        Visibility="{Binding Banner, Converter={StaticResource NullVisibility}}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Top" Margin="0,2,10,0" />
                        <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" LineHeight="20" />
                    </DockPanel>
                </Border>

                <!-- Two connections tied for Windows' default route: one-click fix -->
                <Border Background="{StaticResource WarnTintBrush}" BorderBrush="#55F5A524" BorderThickness="1"
                        CornerRadius="10" Padding="14,10" Margin="0,16,0,0"
                        Visibility="{Binding RouteTieText, Converter={StaticResource NullVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Fix it" VerticalAlignment="Center"
                                Margin="14,0,0,0" Command="{Binding FixRouteTieCommand}"
                                ToolTip="Give Windows one default connection. Needs no restart." />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Top" Margin="0,2,10,0" />
                        <TextBlock Text="{Binding RouteTieText}" TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Networks -->
            <TextBlock Grid.Row="2" Text="YOUR NETWORKS" Style="{StaticResource Section}" Margin="0,24,0,10" />
            <ItemsControl Grid.Row="3" ItemsSource="{Binding Roles}" Margin="0,0,-12,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Change" Style="{StaticResource LinkButton}" VerticalAlignment="Top"
                                            Command="{Binding DataContext.ChangeRoleAdapterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Border Width="42" Height="42" CornerRadius="10" Background="{Binding RoleTint}">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="19"
                                                   Foreground="{Binding RoleBrush}" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Section}" />
                                        <TextBlock Text="{Binding AdapterName}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,14,0,0" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" ToolTip="Download speed right now">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding DownRate}" FontSize="17" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" ToolTip="Upload speed right now">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE898;" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding UpRate}" FontSize="17" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding SessionText}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                           Visibility="{Binding SessionText, Converter={StaticResource NullVisibility}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Ellipse Width="8" Height="8" Fill="{Binding HealthBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding HealthText}" FontSize="13" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding Note}" Foreground="{StaticResource WarnBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="{Binding Note, Converter={StaticResource NullVisibility}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Apps header -->
            <StackPanel Grid.Row="4" Margin="0,22,0,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding AddAppCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" />
                            <TextBlock Text="Add App" />
                        </StackPanel>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="YOUR APPS" Style="{StaticResource Section}" />
                        <TextBlock Text="{Binding RedirectText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,12,0"
                                   Visibility="{Binding RedirectText, Converter={StaticResource NullVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <!-- Apps -->
            <Grid Grid.Row="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                    <ItemsControl ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="9" Background="{Binding RoleTint}">
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="16"
                                                       Foreground="{Binding RoleBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource PillButton}" Background="{Binding RoleTint}" Foreground="{Binding RoleBrush}"
                                                ToolTip="Change network" VerticalAlignment="Center"
                                                Command="{Binding DataContext.ChangeNetworkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="12" Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding RoleLabel}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="9" Margin="7,1,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Border Grid.Column="3" Style="{StaticResource Pill}" Background="{Binding StatusTint}" Margin="8,0" MinWidth="96">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Why?" Style="{StaticResource LinkButton}"
                                                    Command="{Binding DataContext.WhyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource IconButton}" ToolTip="{Binding PauseTip}"
                                                    Command="{Binding DataContext.TogglePauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding PauseGlyph}" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" ToolTip="Remove"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding HasNoApps, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="34" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No apps yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Add a game to keep it on your Gaming network, and Steam to keep its downloads off it." />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Overlay -->
        <Grid Background="{StaticResource ScrimBrush}" Visibility="{Binding Overlay, Converter={StaticResource NullVisibility}}">
            <Border Style="{StaticResource Card}" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentControl Content="{Binding Overlay}" />
            </Border>
        </Grid>

        <!-- Toast -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24" Padding="16,11" CornerRadius="10"
                Background="#262B36" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MaxWidth="640"
                Visibility="{Binding Toast, Converter={StaticResource NullVisibility}}">
            <DockPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource DownloadsBrush}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Toast}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
