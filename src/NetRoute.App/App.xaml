<Application x:Class="NetRoute.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NetRoute.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:EqualsVisibilityConverter x:Key="PageVisibility" />
            <local:NullVisibilityConverter x:Key="NullVisibility" />
            <local:CountVisibilityConverter x:Key="CountVisibility" />
            <local:BoolVisibilityConverter x:Key="BoolVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
