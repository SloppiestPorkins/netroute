<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- For the tray icon only. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Product>NetRoute</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only here for NotifyIcon. Keep its namespaces out of the global usings so
         Application, Button, Brush and friends stay unambiguous WPF types. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetRoute.Core\NetRoute.Core.csproj" />
    <ProjectReference Include="..\NetRoute.Windows\NetRoute.Windows.csproj" />
    <ProjectReference Include="..\NetRoute.Ipc\NetRoute.Ipc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

</Project>
