<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>netroute-poc</AssemblyName>
    <RootNamespace>NetRoute.Poc</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetRoute.Core\NetRoute.Core.csproj" />
    <ProjectReference Include="..\NetRoute.Windows\NetRoute.Windows.csproj" />
    <!-- So `netroute-poc selftest` can run the service's own test without installing anything. -->
    <ProjectReference Include="..\NetRoute.Service\NetRoute.Service.csproj" />
  </ItemGroup>

</Project>
