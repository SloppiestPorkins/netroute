<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetRoute.Core\NetRoute.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- To start the split-tunnel driver after a restart (SplitTunnelDriver.TryStartService). -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The interop structs are internal, but their layout is the highest-risk thing
         in the project and must be asserted directly rather than inferred. -->
    <InternalsVisibleTo Include="NetRoute.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.6" />
  </ItemGroup>

</Project>
