<Window x:Class="NetRoute.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NetRoute.Setup"
        Title="{Binding WindowTitle}" Width="720" Height="600" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <local:PageVisibility x:Key="Page" />
        <local:NullVisibility x:Key="Null" />
        <local:BoolVisibility x:Key="Bool" />
        <local:BoolVisibility x:Key="NotBool" Invert="True" />
    </Window.Resources>

    <Grid x:Name="Root" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: the NetRoute mark (two routes), then what's happening -->
        <DockPanel Margin="40,34,40,0">
            <Viewbox Width="54" Height="54" VerticalAlignment="Center">
                <Canvas Width="32" Height="32">
                    <Ellipse Canvas.Left="1" Canvas.Top="1" Width="30" Height="30" Fill="{StaticResource SurfaceAltBrush}" />
                    <Path Data="M8,24 C12,24 14,10 24,9" Stroke="#22C55E" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M8,24 C16,24 18,22 24,23" Stroke="#4F8DF7" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
            </Viewbox>
            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Heading}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subheading}" Style="{StaticResource Caption}" Margin="0,3,0,0"
                           Visibility="{Binding Subheading, Converter={StaticResource Null}}" />
            </StackPanel>
        </DockPanel>

        <!-- Pages -->
        <Grid Grid.Row="1" Margin="40,26,40,20">

            <!-- Welcome: options -->
            <StackPanel Visibility="{Binding Page, Converter={StaticResource Page}, ConverterParameter=Welcome}">
                <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource MutedBrush}" LineHeight="22" />

                <StackPanel Margin="0,26,0,0" Visibility="{Binding IsInstall, Converter={StaticResource Bool}}">
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="16,13" Margin="0,0,0,18"
                            Visibility="{Binding DriverAlreadyRunning, Converter={StaticResource Bool}}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource GoodBrush}" FontSize="16"
                                       VerticalAlignment="Top" Margin="0,2,14,0" />
                            <StackPanel>
                                <TextBlock Text="App moving is already set up" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                                           Text="Mullvad's split-tunnel driver is running. Setup makes sure it starts with Windows." />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <CheckBox IsChecked="{Binding SetUpDriver}" Margin="0,0,0,18"
                              Visibility="{Binding DriverAlreadyRunning, Converter={StaticResource NotBool}}">
                        <StackPanel>
                            <TextBlock Text="Set up app moving" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                                       Text="Installs Mullvad's Microsoft-signed split-tunnel driver (98 KB). No VPN app and no account." />
                        </StackPanel>
                    </CheckBox>

                    <TextBlock Text="{Binding MullvadNote}" Foreground="{StaticResource WarnBrush}" FontSize="13" TextWrapping="Wrap"
                               Margin="34,-8,0,18" Visibility="{Binding MullvadNote, Converter={StaticResource Null}}" />

                    <CheckBox IsChecked="{Binding StartWithWindows}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Start NetRoute when I sign in" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                                       Text="It opens in the tray. Protection itself runs as a Windows service either way." />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding DesktopShortcut}">
                        <TextBlock Text="Add a desktop shortcut" FontWeight="SemiBold" />
                    </CheckBox>
                </StackPanel>

                <CheckBox IsChecked="{Binding RemoveSettings}" Margin="0,26,0,0"
                          Visibility="{Binding IsUninstall, Converter={StaticResource Bool}}">
                    <StackPanel>
                        <TextBlock Text="Also delete my app list and settings" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                                   Text="Keep them if you might install NetRoute again." />
                    </StackPanel>
                </CheckBox>
            </StackPanel>

            <!-- Progress -->
            <Grid Visibility="{Binding Page, Converter={StaticResource Page}, ConverterParameter=Progress}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding Brush}" FontSize="16"
                                           Width="30" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               Visibility="{Binding Detail, Converter={StaticResource Null}}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ProgressBar Grid.Row="1" Value="{Binding Progress, Mode=OneWay}" Maximum="1" Margin="0,6,0,0" />
            </Grid>

            <!-- Done or failed -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Page}" Value="Done">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Page}" Value="Failed">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding DoneMessage}" TextWrapping="Wrap" FontSize="15" LineHeight="22" />
                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,18,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#26F5A524" CornerRadius="10" Padding="14,11" Margin="0,0,0,8">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource WarnBrush}"
                                               VerticalAlignment="Top" Margin="0,2,12,0" />
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox IsChecked="{Binding LaunchWhenDone}" Margin="0,18,0,0"
                          Visibility="{Binding CanLaunch, Converter={StaticResource Bool}}">
                    <TextBlock Text="Open NetRoute now" FontWeight="SemiBold" />
                </CheckBox>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="40,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Content="{Binding SecondaryText}" Command="{Binding SecondaryCommand}"
                            Margin="0,0,10,0" Visibility="{Binding ShowSecondary, Converter={StaticResource Bool}}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}"
                            IsDefault="True" Visibility="{Binding ShowPrimary, Converter={StaticResource Bool}}" />
                </StackPanel>
                <TextBlock Text="{Binding Footer}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap"
                           LineHeight="18" Margin="0,0,20,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
