<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- sizeof() on the interop structs, so their layout can be asserted rather than assumed. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The live view's decisions live in plain files in the WPF project; linked in so they can be tested without a window. -->
    <Compile Include="..\..\src\NetRoute.App\LiveModel.cs" Link="App\LiveModel.cs" />
    <Compile Include="..\..\src\NetRoute.App\Format.cs" Link="App\Format.cs" />
    <Compile Include="..\..\src\NetRoute.App\Wording.cs" Link="App\Wording.cs" />

    <!-- Setup's decision rules, which are deliberately free of the machine so they can be tested
         here. Linked rather than referenced: NetRoute.Setup is a WPF program with the whole
         payload embedded in it. -->
    <Compile Include="..\..\src\NetRoute.Setup\Logic\RestorePolicy.cs" Link="Setup\RestorePolicy.cs" />
    <Compile Include="..\..\src\NetRoute.Setup\Logic\RollbackPlan.cs" Link="Setup\RollbackPlan.cs" />
    <Compile Include="..\..\src\NetRoute.Setup\Logic\SelfDelete.cs" Link="Setup\SelfDelete.cs" />
    <Compile Include="..\..\src\NetRoute.Setup\Logic\SetupExit.cs" Link="Setup\SetupExit.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetRoute.Core\NetRoute.Core.csproj" />
    <ProjectReference Include="..\..\src\NetRoute.Windows\NetRoute.Windows.csproj" />
    <ProjectReference Include="..\..\src\NetRoute.Ipc\NetRoute.Ipc.csproj" />
    <ProjectReference Include="..\..\src\NetRoute.Service\NetRoute.Service.csproj" />
  </ItemGroup>

</Project>
